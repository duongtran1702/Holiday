# =========================================================================
# FILE MẪU BIẾN MÔI TRƯỜNG - HOLIDAY MICROSERVICES (.env.example)
# =========================================================================
# Hướng dẫn:
# 1. Sao chép file này thành .env:
#    cp .env.example .env  (hoặc copy .env.example .env trên Windows)
# 2. Điền các giá trị thực tế tương ứng với tài khoản dịch vụ của bạn.
# =========================================================================

# 1. BẢO MẬT & JWT AUTHENTICATION
# Khóa bí mật ký JWT Token (yêu cầu chuỗi Base64 tối thiểu 256 bits)
JWT_SECRET_KEY=WVhSdGFXNHRkSEpoYmkxMmFYQXRjSEp2TFdWc2FYUmxMV1JsZG1Wc2IzQmxjaTFpWVdOclpXNWtMVEpyTmc9PQ==

# 2. LƯU TRỮ HÌNH ẢNH (CLOUDINARY)
# Lấy từ dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 3. DỊCH VỤ EMAIL (RESEND SMTP)
# Lấy API Key từ: https://resend.com/api-keys
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_FROM=your_verified_email@yourdomain.com
MAIL_PASSWORD=your_resend_smtp_api_key

# 4. CƠ SỞ DỮ LIỆU & HẠ TẦNG PHÂN TÁN
# Cấu hình mặc định khi chạy Docker hoặc Localhost
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EUREKA_SERVER_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888/
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# 5. CỔNG THANH TOÁN (PAYOS)
# Lấy từ cổng tích hợp PayOS: https://payos.vn/
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# 6. XÁC THỰC GOOGLE OAUTH2
# Lấy từ Google Cloud Console (Credentials):
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# 7. FRONTEND CLIENT
FRONTEND_URL=http://localhost:5173
